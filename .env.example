# ==============================================================================
# AI CHATBOT CONFIGURATION
# ==============================================================================

# Option 1: Groq API Key (Recommended - 100% Free, No Credit Card)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GOOGLE_CHAT_MODEL=gemini-1.5-flash

# Upstash Redis Rate Limiting (Server-side only, Optional)
# Create a free database at: https://upstash.com/
# If left blank, the chatbot gracefully falls back to an in-memory rate limiter.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ==============================================================================
# CONTACT FORM & SMTP CONFIGURATION (Server-side only)
# ==============================================================================
# To use Gmail SMTP, you need to set up an App Password:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account → Security → 2-Step Verification → App passwords
# 3. Generate a new app password for "Mail"
# 4. Use the generated 16-character password as SMTP_PASS below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=recipient@example.com

# ==============================================================================
# OTHER CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_GTM=your_google_tag_manager_id
NEXT_PUBLIC_APP_URL=https://saad-raja-dev-site.vercel.app